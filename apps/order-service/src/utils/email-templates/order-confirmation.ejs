<!DOCTYPE html>
<html lang="en">
  <head>
    <title>Order Confirmation - Zshop</title>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <style type="text/css">
      /*Base*/
      body {
        margin: 0;
        padding: 0;
        background-color: #f9fafb;
        font-family: Arial, sans-serif;
        color: #222222;
      }

      .container {
        max-width: 600px;
        margin: auto;
        background: #ffffff;
        border-radius: 8px;
        overflow: hidden;
        box-shadow: 0 0 10px rgba(0, 0, 0, 0.04);
      }

      .header {
        margin: 0;
        font-size: 24px;
      }

      .header h1 {
        font-size: 24px;
        font-weight: 700;
        line-height: 1.25;
        margin-top: 0;
        margin-bottom: 15px;
        text-align: center;
      }

      .body {
        padding: 30px;
      }

      .body h2 {
        margin-top: 0;
        font-size: 20px;
        color: #111827;
      }

      .order-summary {
        background-color: #f3f4f6;
        padding: 15px;
        border-radius: 6px;
        margin-top: 20px;
        font-size: 14px;
      }

      .order-summary p {
        margin: 6px 0;
        line-height: 1.4;
      }

      .total {
        font-weight: bold;
        font-size: 16px;
        margin-top: 10px;
      }

      .button {
        display: inline-block;
        background-color: #2563eb;
        color: #ffffff;
        padding: 12px 20px;
        margin-top: 30px;
        text-decoration: 5px;
        font-weight: bold;
      }

      .footer {
        padding: 20px;
        font-size: 12px;
        text-align: center;
        color: #6b7280;
        background-color: #f9fafb;
      }
    </style>
  </head>
  <body>
    <div class="container">
      <div class="header"><h1>Order Confirmed</h1></div>
      <div class="email-body">
        <p>Hello <%= name %>,</p>
        <p>
          Thank you for your purchase! we've received your order and will start
          processing it shortly.
        </p>

        <div class="order-summary">
          <% cart.forEach(item => { %>
          <p>
            <strong> <%= item.title %> </strong> - <%= item.quantity %> x $<%=
            item.sales_price.toFixed(2) %>
          </p>
          <% }) %>

          <p class="total">Total : $<%= totalAmount.toFixed(2) %></p>
        </div>

        <a href="<%= trackingUrl %>" class="button">Track Your Order</a>

        <p style="margin-top: 20px">
          If you have any questions, just reply to this email or contact us at
          <a href="mailto:support@zshop.com">support@zshop.com</a>
        </p>
      </div>

      <div class="footer">
        &copy; <%= new Date().getFullYear() %> Zshop. All rights reserved
      </div>
    </div>
  </body>
</html>
